# Zugangsschutz: am einfachsten im Netcup-Kundenmenü (Plesk) unter
# "Passwortgeschützte Verzeichnisse" für diese Subdomain einrichten.
# Dann liegt kein Passwort im Repo und diese Datei braucht keinen Auth-Block.
#
# Alternative ohne Plesk: die folgenden Zeilen einkommentieren, den absoluten
# Serverpfad anpassen und die .htpasswd außerhalb des Webverzeichnisses ablegen.
#
# AuthType Basic
# AuthName "Section Viewer"
# AuthUserFile /var/www/vhosts/HOSTINGNAME/.htpasswd-sectionviewer
# Require valid-user

# Versteckte Dateien (.git, .gitignore, .htpasswd ...) nie ausliefern
RedirectMatch 404 /\.(?!well-known)

# Die README gehört zum Repo, nicht zur Seite (Plesk stellt das ganze Repo bereit)
RedirectMatch 404 (?i)/README\.md$

# Falls doch einmal Aufzeichnungen oder Sessions im Webverzeichnis landen: nicht ausliefern
<FilesMatch "(\.(fit|gpx)|_session\.json)$">
  Require all denied
</FilesMatch>

# Nicht in Suchmaschinen aufnehmen
<IfModule mod_headers.c>
  Header set X-Robots-Tag "noindex, nofollow"
</IfModule>

# Seite, CSS und JS bei jedem Aufruf beim Server prüfen lassen (kostet bei
# unveränderten Dateien nur eine kurze 304-Antwort), damit nach einem Deploy
# nicht alte und neue Dateien gemischt im Browser landen
<IfModule mod_headers.c>
  <FilesMatch "\.(html|css|js)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>

Options -Indexes
